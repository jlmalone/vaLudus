    {"path": "behavior.media_stress_minutes", "low": 10.0, "high": 60.0},
    {"path": "behavior.media_exposure_reference_minutes", "low": 80.0, "high": 180.0},
    {"path": "behavior.media_exposure_weight", "low": 0.20, "high": 0.80},
