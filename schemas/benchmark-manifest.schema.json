{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valudus:schema:benchmark-manifest:1.1",
  "title": "vaLudus Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "task_family", "capability_claim", "metrics", "success_threshold", "failure_cases", "contamination", "budget", "fixtures", "evaluation", "execution"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "task_family": {"type": "string", "minLength": 1},
    "capability_claim": {"type": "string", "minLength": 1},
    "input_provenance": {"type": "string"},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "direction", "unit"], "properties": {"name": {"type": "string"}, "direction": {"enum": ["higher_is_better", "lower_is_better", "target_is_better"]}, "unit": {"type": "string"}}}},
    "success_threshold": {"type": "string", "minLength": 1},
    "failure_cases": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "robustness_checks": {"type": "array", "items": {"type": "string"}},
    "anti_gaming_checks": {"type": "array", "items": {"type": "string"}},
    "contamination": {"type": "object", "additionalProperties": false, "required": ["risk_level", "mitigations", "residual_risk"], "properties": {"risk_level": {"enum": ["low", "medium", "high", "unknown"]}, "mitigations": {"type": "array", "items": {"type": "string"}}, "residual_risk": {"type": "string", "minLength": 1}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["tokens", "money_usd", "wall_time_seconds", "compute", "memory_mb"], "properties": {"tokens": {"$ref": "#/$defs/numericBudget"}, "money_usd": {"$ref": "#/$defs/numericBudget"}, "wall_time_seconds": {"$ref": "#/$defs/numericBudget"}, "compute": {"type": "string", "minLength": 1}, "memory_mb": {"$ref": "#/$defs/numericBudget"}}},
    "fixtures": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "partition", "input", "expected"], "properties": {"id": {"type": "string", "minLength": 1}, "partition": {"enum": ["development", "held_out", "adversarial"]}, "input": {"type": "object"}, "expected": {"type": "object"}}}},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["scorer", "primary_metric"], "properties": {"scorer": {"const": "exact_match"}, "primary_metric": {"const": "exact_match_rate"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["seed"], "properties": {"seed": {"type": "integer"}}}
  },
  "$defs": {
    "numericBudget": {"type": "object", "additionalProperties": false, "required": ["maximum"], "properties": {"maximum": {"type": ["number", "null"], "minimum": 0}}}
  }
}
